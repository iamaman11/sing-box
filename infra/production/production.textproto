schema_version: 6
environment: "production"
machine_id: "production-1"
public_hostname: "miu.alegria.by"
windows_datapath_mode: WINDOWS_DATAPATH_MODE_MANAGED_TUN
windows_route_policy {
  desktop: WINDOWS_DEFAULT_ROUTE_AUTO_DIRECT
  wsl: WINDOWS_DEFAULT_ROUTE_AUTO_DIRECT
}

machine {
  role: "edge"
  region: "waw"
  plan: "vc2-1c-1gb"
  os_id: 2625
  enable_ipv6: false
  bootstrap_profile: "singbox-host-v2"
  application_profiles: "production"
  tags: "production"
  tags: "primary"
  tags: "public-egress"
}

vpc {
  region: "waw"
}

application {
  application_profile: "production"
  bundle_root: "win/vultr-waw/stack"
  runtime_env_required: true
  bootstrap_mode: PRODUCTION_BOOTSTRAP_MODE_FULL

  line1 {
    tunnel_domain: "miu.alegria.by"
    acme_email: "admin@alegria.by"
    acme_provider: "letsencrypt"
    reality_server_name: "www.microsoft.com"
  }

  line2 {
    proxy_username: "production"
    proxy_cert_cn: "miu.alegria.by"
  }
}

cloudflare {
  active_account_id: "6be6e4b6340822dbeb18cb6c2f09c660"
  credential_plane {
    access_organization_name: "sing-box"
    access_auth_domain: "sing-box-6be6e4b6.cloudflareaccess.com"
    windows_worker_name: "sing-box-credentials-windows"
    vm_worker_name: "sing-box-credentials-vm"
    windows_access_application_name: "sing-box-credentials-windows-access"
    vm_access_application_name: "sing-box-credentials-vm-access"
    windows_access_policy_name: "sing-box-credentials-windows-service-auth"
    vm_access_policy_name: "sing-box-credentials-vm-service-auth"
    worker_compatibility_date: "2026-09-28"
    workers_dev_subdomain: "sing-box-6be6e4b6340822dbeb18cb6c2f09c660"
    windows_host_service_token_name: "sing-box-credentials-windows-host"
    vm_host_service_token_name: "sing-box-credentials-vm-host"
    host_service_token_duration: "forever"
  }

  target_plane {
    mesh_profile_name: "sing-box Mesh nodes"
    mesh_profile_description: "Project Mesh nodes: Traffic and DNS over MASQUE with required Cloudflare Mesh ranges"
    mesh_profile_precedence_start: 100
    mesh_profile_service_mode: "warp"
    mesh_profile_tunnel_protocol: "masque"
    mesh_profile_auto_connect: 1
    mesh_profile_switch_locked: true
    mesh_profile_include_cidrs: "100.64.0.0/12"
    mesh_profile_include_cidrs: "100.96.0.0/12"
  }
}

dns {
  zone_name: "alegria.by"
  record_name: "miu.alegria.by"
  account_id: "4426df1449e417511bc7697d60b7f62f"
}

mesh {
  node_name: "singbox-line3-production"
}

support_access {
  controller_ipv4_ssh: true
}

firewall {
  rules {
    ip_family: PRODUCTION_IP_FAMILY_V4
    protocol: PRODUCTION_TRANSPORT_PROTOCOL_TCP
    subnet: "0.0.0.0"
    prefix_length: 0
    port: "80"
    purpose: "production ACME HTTP-01"
  }
  rules {
    ip_family: PRODUCTION_IP_FAMILY_V4
    protocol: PRODUCTION_TRANSPORT_PROTOCOL_TCP
    subnet: "0.0.0.0"
    prefix_length: 0
    port: "443"
    purpose: "Line 1 VLESS Reality direct"
  }
  rules {
    ip_family: PRODUCTION_IP_FAMILY_V4
    protocol: PRODUCTION_TRANSPORT_PROTOCOL_UDP
    subnet: "0.0.0.0"
    prefix_length: 0
    port: "8443"
    purpose: "Line 1 Hysteria2 direct"
  }
  rules {
    ip_family: PRODUCTION_IP_FAMILY_V4
    protocol: PRODUCTION_TRANSPORT_PROTOCOL_TCP
    subnet: "0.0.0.0"
    prefix_length: 0
    port: "5443"
    purpose: "Line 1 VLESS Reality WARP"
  }
  rules {
    ip_family: PRODUCTION_IP_FAMILY_V4
    protocol: PRODUCTION_TRANSPORT_PROTOCOL_UDP
    subnet: "0.0.0.0"
    prefix_length: 0
    port: "9444"
    purpose: "Line 1 Hysteria2 WARP"
  }
  rules {
    ip_family: PRODUCTION_IP_FAMILY_V4
    protocol: PRODUCTION_TRANSPORT_PROTOCOL_TCP
    subnet: "0.0.0.0"
    prefix_length: 0
    port: "3128"
    purpose: "Line 2 authenticated HTTP proxy"
  }
  rules {
    ip_family: PRODUCTION_IP_FAMILY_V4
    protocol: PRODUCTION_TRANSPORT_PROTOCOL_TCP
    subnet: "0.0.0.0"
    prefix_length: 0
    port: "1080"
    purpose: "Line 2 authenticated SOCKS proxy"
  }
  rules {
    ip_family: PRODUCTION_IP_FAMILY_V4
    protocol: PRODUCTION_TRANSPORT_PROTOCOL_TCP
    subnet: "0.0.0.0"
    prefix_length: 0
    port: "9443"
    purpose: "Line 2 authenticated HTTPS proxy"
  }
  rules {
    ip_family: PRODUCTION_IP_FAMILY_V4
    protocol: PRODUCTION_TRANSPORT_PROTOCOL_TCP
    subnet: "0.0.0.0"
    prefix_length: 0
    port: "4128"
    purpose: "Line 2 authenticated direct HTTP proxy"
  }
  rules {
    ip_family: PRODUCTION_IP_FAMILY_V4
    protocol: PRODUCTION_TRANSPORT_PROTOCOL_TCP
    subnet: "0.0.0.0"
    prefix_length: 0
    port: "4080"
    purpose: "Line 2 authenticated direct SOCKS proxy"
  }
  rules {
    ip_family: PRODUCTION_IP_FAMILY_V4
    protocol: PRODUCTION_TRANSPORT_PROTOCOL_TCP
    subnet: "0.0.0.0"
    prefix_length: 0
    port: "4443"
    purpose: "Line 2 authenticated direct HTTPS proxy"
  }
}
