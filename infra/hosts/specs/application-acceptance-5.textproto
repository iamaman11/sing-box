schema_version: 1
environment: "application-acceptance-5"
machine_id: "application-acceptance-5"
firewall_profile: "application-acceptance"
machine {
  role: "application-acceptance"
  region: "waw"
  plan: "vc2-1c-1gb"
  os_id: 2625
  bootstrap_profile: "singbox-native-first-use-v1"
  application_profiles: "application-acceptance"
  tags: "disposable-application-acceptance-5"
}
application {
  application_profile: "application-acceptance"
  bundle_root: "win/vultr-waw/stack"
  runtime_env_required: true
  bootstrap_mode: PRODUCTION_BOOTSTRAP_MODE_FULL
  line1 {
    tunnel_domain: "miu.alegria.by"
    acme_email: "admin@alegria.by"
    acme_provider: "letsencrypt"
    reality_server_name: "www.microsoft.com"
  }
  line2 {
    proxy_username: "acceptance"
    proxy_cert_cn: "miu.alegria.by"
  }
}
