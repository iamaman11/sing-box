{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "upstream-cloudflare",
        "type": "udp",
        "server": "1.1.1.1"
      },
      {
        "tag": "upstream-google",
        "type": "udp",
        "server": "8.8.8.8"
      }
    ],
    "final": "upstream-cloudflare",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-main",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "uuid": "${VLESS_UUID}",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "${REALITY_SERVER_NAME}",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "${REALITY_SERVER_NAME}",
            "server_port": 443
          },
          "private_key": "${REALITY_PRIVATE_KEY}",
          "short_id": [
            "${REALITY_SHORT_ID}"
          ]
        }
      }
    },
    {
      "type": "hysteria2",
      "tag": "hy2-direct-main",
      "listen": "::",
      "listen_port": 8443,
      "users": [
        {
          "password": "${HY2_PASSWORD}"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "${TUNNEL_DOMAIN}",
        "alpn": [
          "h3"
        ],
        "acme": {
          "domain": [
            "${TUNNEL_DOMAIN}"
          ],
          "email": "${ACME_EMAIL}",
          "provider": "letsencrypt",
          "data_directory": "/var/lib/sing-box/acme",
          "disable_tls_alpn_challenge": true
        }
      },
      "ignore_client_bandwidth": true,
      "masquerade": "https://www.bing.com"
    },
    {
      "type": "vless",
      "tag": "vless-reality-warp",
      "listen": "::",
      "listen_port": 5443,
      "users": [
        {
          "uuid": "${VLESS_WARP_UUID}",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "${REALITY_SERVER_NAME}",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "${REALITY_SERVER_NAME}",
            "server_port": 443
          },
          "private_key": "${REALITY_WARP_PRIVATE_KEY}",
          "short_id": [
            "${REALITY_WARP_SHORT_ID}"
          ]
        }
      }
    },
    {
      "type": "hysteria2",
      "tag": "hy2-warp",
      "listen": "::",
      "listen_port": 9444,
      "users": [
        {
          "password": "${HY2_WARP_PASSWORD}"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "${TUNNEL_DOMAIN}",
        "alpn": [
          "h3"
        ],
        "acme": {
          "domain": [
            "${TUNNEL_DOMAIN}"
          ],
          "email": "${ACME_EMAIL}",
          "provider": "letsencrypt",
          "data_directory": "/var/lib/sing-box/acme",
          "disable_tls_alpn_challenge": true
        }
      },
      "ignore_client_bandwidth": true,
      "masquerade": "https://www.bing.com"
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "warp-local",
      "server": "warp-egress",
      "server_port": 11080,
      "version": "5",
      "network": "tcp"
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "ip_is_private": true,
        "outbound": "block"
      },
      {
        "inbound": [
          "vless-reality-warp",
          "hy2-warp"
        ],
        "outbound": "warp-local"
      }
    ],
    "final": "direct",
    "default_domain_resolver": "upstream-cloudflare"
  }
}
