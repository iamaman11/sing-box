{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "cloudflare",
        "type": "udp",
        "server": "1.1.1.1"
      },
      {
        "tag": "quad9",
        "type": "udp",
        "server": "9.9.9.9"
      }
    ],
    "final": "cloudflare",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "http",
      "tag": "http-proxy-auth",
      "listen": "::",
      "listen_port": 3128,
      "users": [
        {
          "username": "${PROXY_USERNAME}",
          "password": "${PROXY_PASSWORD}"
        }
      ]
    },
    {
      "type": "socks",
      "tag": "socks-proxy-auth",
      "listen": "::",
      "listen_port": 1080,
      "users": [
        {
          "username": "${PROXY_USERNAME}",
          "password": "${PROXY_PASSWORD}"
        }
      ]
    },
    {
      "type": "http",
      "tag": "https-proxy-auth",
      "listen": "::",
      "listen_port": 9443,
      "users": [
        {
          "username": "${PROXY_USERNAME}",
          "password": "${PROXY_PASSWORD}"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "${PROXY_CERT_PATH}",
        "key_path": "${PROXY_KEY_PATH}",
        "min_version": "1.2",
        "alpn": [
          "h2",
          "http/1.1"
        ]
      }
    },
    {
      "type": "http",
      "tag": "http-proxy-direct-auth",
      "listen": "::",
      "listen_port": 4128,
      "users": [
        {
          "username": "${PROXY_USERNAME}",
          "password": "${PROXY_PASSWORD}"
        }
      ]
    },
    {
      "type": "socks",
      "tag": "socks-proxy-direct-auth",
      "listen": "::",
      "listen_port": 4080,
      "users": [
        {
          "username": "${PROXY_USERNAME}",
          "password": "${PROXY_PASSWORD}"
        }
      ]
    },
    {
      "type": "http",
      "tag": "https-proxy-direct-auth",
      "listen": "::",
      "listen_port": 4443,
      "users": [
        {
          "username": "${PROXY_USERNAME}",
          "password": "${PROXY_PASSWORD}"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "${PROXY_CERT_PATH}",
        "key_path": "${PROXY_KEY_PATH}",
        "min_version": "1.2",
        "alpn": [
          "h2",
          "http/1.1"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "warp-local",
      "server": "warp-egress",
      "server_port": 11080,
      "version": "5",
      "network": "tcp"
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "ip_is_private": true,
        "outbound": "block"
      },
      {
        "inbound": [
          "http-proxy-auth",
          "socks-proxy-auth",
          "https-proxy-auth"
        ],
        "outbound": "warp-local"
      }
    ],
    "final": "direct",
    "default_domain_resolver": "cloudflare"
  }
}
